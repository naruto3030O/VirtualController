<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!--
      Placeholder for the drifting green haze. Sits low and stays subtle so it
      reads as light spilling in from off-screen rather than a coloured panel.
      Replaced by an animated shader later.
    -->
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#3D1FD455"
        android:centerColor="#0F1FD455"
        android:endColor="#001FD455"
        android:centerY="0.25" />
</shape>